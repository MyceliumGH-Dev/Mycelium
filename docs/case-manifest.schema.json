{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MyceliumGH-Dev/Mycelium/blob/dev/docs/case-manifest.schema.json",
  "title": "Mycelium Case Manifest",
  "description": "Parameter, provenance, geometry-summary, and metric sidecar for a generated Mycelium case.",
  "type": "object",
  "required": ["schema", "schemaVersion", "caseId", "generator", "parameters", "geometry", "development", "morphology"],
  "properties": {
    "schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": "1.2.0" },
    "caseId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "generator": {
      "type": "object",
      "required": ["name", "version", "repository"],
      "properties": {
        "name": { "const": "Mycelium" },
        "version": { "type": "string" },
        "repository": { "type": "string", "format": "uri" }
      }
    },
    "parameters": {
      "type": "object",
      "required": ["seed", "modelUnits", "modelAbsoluteTolerance", "boundaryCanonicalTolerance", "boundaryCanonicalDecimals", "floorHeight", "divisions", "streetWidth", "requestedParks", "generateFloorSlabs", "streetNetworkFamily", "streetNetworkSubtype", "buildingConfigurations", "treeConfiguration", "treeConfigurationProvided", "analysisDirection"],
      "properties": {
        "seed": { "type": "integer" },
        "modelUnits": { "type": "string" },
        "modelAbsoluteTolerance": { "type": "number", "exclusiveMinimum": 0 },
        "boundaryDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the canonical boundary form. Absent when the boundary could not be canonicalized, in which case the case identifier does not distinguish sites."
        },
        "boundaryCanonicalTolerance": { "type": "number", "exclusiveMinimum": 0 },
        "boundaryCanonicalDecimals": { "type": "integer", "minimum": 0 },
        "floorHeight": { "type": "number", "exclusiveMinimum": 0 },
        "divisions": { "type": "integer", "minimum": 0 },
        "streetWidth": { "type": "number", "minimum": 0 },
        "requestedParks": { "type": "integer", "minimum": 0 },
        "generateFloorSlabs": { "type": "boolean" },
        "streetNetworkFamily": { "type": "string" },
        "streetNetworkSubtype": { "type": "string" },
        "buildingConfigurations": { "type": "array", "items": { "type": "string" } },
        "treeConfiguration": { "type": "string" },
        "treeConfigurationProvided": { "type": "boolean" },
        "analysisDirection": { "$ref": "#/$defs/direction" },
        "targetFloorAreaRatio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Site FAR (GFA / site area) the floor counts were solved for. Absent when floors were drawn at random; part of the case identifier only when present."
        }
      }
    },
    "geometry": { "$ref": "#/$defs/counts" },
    "development": { "$ref": "#/$defs/numericObject" },
    "morphology": { "$ref": "#/$defs/numericObject" },
    "parcels": {
      "type": "array",
      "description": "One entry per subdivision parcel in generation order. Derived output; not part of the case identifier.",
      "items": { "$ref": "#/$defs/parcel" }
    }
  },
  "$defs": {
    "parcel": {
      "type": "object",
      "required": ["id", "use", "area", "floors", "height", "footprintArea", "grossFloorArea", "floorAreaRatio"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "description": "Index in the subdivision; stable only while boundary, network, divisions, street width, seed and the smallest MinArea are unchanged." },
        "use": { "enum": ["building", "park", "empty"] },
        "area": { "type": "number", "minimum": 0 },
        "buildingType": { "type": "string", "description": "Typology of the building; absent for parks and empty parcels." },
        "floors": { "type": "integer", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 },
        "footprintArea": { "type": "number", "minimum": 0 },
        "grossFloorArea": { "type": "number", "minimum": 0 },
        "floorAreaRatio": { "type": "number", "minimum": 0, "description": "Parcel GFA / parcel area." },
        "targetGrossFloorArea": { "type": "number", "minimum": 0, "description": "Share of the target GFA assigned to this parcel; absent without a target FAR." }
      }
    },
    "direction": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "numericObject": {
      "type": "object",
      "additionalProperties": { "type": ["number", "integer"] }
    }
  }
}
