<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(NuGetPackageRoot)rhinocommon\8.0.23304.9001\lib\net48\RhinoCommon.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <None Include="$(NuGetPackageRoot)rhinocommon\8.0.23304.9001\lib\net48\RhinoCommon.dll">
      <Link>RhinoCommon.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Mycelium\Core\CaseManifest.cs" Link="Core\CaseManifest.cs" />
    <Compile Include="..\..\src\Mycelium\Core\GeometryHelpers.cs" Link="Core\GeometryHelpers.cs" />
    <Compile Include="..\..\src\Mycelium\Core\MorphologyMetrics.cs" Link="Core\MorphologyMetrics.cs" />
  </ItemGroup>
</Project>
